{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'REPO=$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --show-toplevel 2>/dev/null) && S=\"$(dirname \"$REPO\")/claude-base/.claude/hooks/session-start.sh\" && [ -f \"$S\" ] && bash \"$S\" || true'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'REPO=$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --show-toplevel 2>/dev/null) && S=\"$(dirname \"$REPO\")/claude-base/.claude/hooks/pre-compact.sh\" && [ -f \"$S\" ] && bash \"$S\" || true'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'REPO=$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --show-toplevel 2>/dev/null) && S=\"$(dirname \"$REPO\")/claude-base/.claude/hooks/post-tool-use.sh\" && [ -f \"$S\" ] && bash \"$S\" || true'"
          }
        ]
      }
    ]
  }
}